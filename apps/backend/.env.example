# Copy to .env for local dev. In Cloud Run, set via --set-env-vars / Secret Manager.
PORT=8080
MODE=echo                     # echo | gemini
GEMINI_API_KEY=               # required for MODE=gemini
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck
# JSON map of deviceId -> bearer token. In prod: Secret Manager.
DEVICE_TOKENS={"dev-local":"local-secret","pixel-001":"change-me"}
SESSION_MAX_MS=600000         # 10 min hard cap, then polite re-handshake
IDLE_TIMEOUT_MS=60000         # disconnect after 60s of silence
DAILY_BUDGET_USD=5            # per-device kill-switch
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_TIMEOUT_MS=30000
SENTRY_DSN=                   # optional, crash reporting only
LOG_LEVEL=info
